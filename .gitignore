# =============================================================================
# fastapi-gpt/.gitignore
# Filosofi: HANYA file yang dibutuhkan FastAPI router runtime yang di-track.
# Yang di-ignore: secrets, output runtime, SEMUA file/folder evaluasi (script,
# data, plot, laporan), SEMUA *.md dokumentasi, dan binary besar.
# Pengecualian: data/prompts/*.md dipertahankan karena router_inquiry.py
# membacanya saat runtime (PROMPTS_DIR).
# =============================================================================

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- Virtual environments ----------
venv/
env/
.venv/

# ---------- IDE / Editor / OS ----------
.vscode/
.idea/
*.tmp
*.swp
*.bak
.DS_Store
Thumbs.db
desktop.ini

# ---------- Native binaries / installers (bukan bagian dari router) ----------
lib/
*.dylib
*.so
*.dll
*.sh
Miniconda3-latest-Linux-x86_64.sh

# =============================================================================
# SECRETS — JANGAN PERNAH DI-COMMIT
# =============================================================================
.env
.env.*
!.env.example
*firebase-adminsdk*.json
serviceAccount*.json
phyphox-*.json
gphysolve-*.json
github token.txt
*github*token*.txt
*api_key*.txt
*api-key*.txt
*secret*.txt
*.pem
*.key

# =============================================================================
# Folder OUTPUT runtime router (gambar, grafik, log, sensor data, table)
# Folder akan dibuat ulang oleh router saat dijalankan.
# =============================================================================
log_file/
raw_sensor_data/
image_raw/
image_result/
table_images/
advance_graph/
easy_graph/
intermediate_graph/

# =============================================================================
# EVALUASI — script, folder, output, laporan. Tidak ada satupun yang di-track.
# =============================================================================
# Script evaluasi/ablation/plot (di root fastapi-gpt)
eval_inquiry_metrics.py
export_inquiry_logs_for_eval.py
generate_and_evaluate.py
generate_and_evaluate_complete.py
gen_ablation_problem_finder.py
plot_ablation.py
plot_eval_results.py
plot_from_results.py
convert_excel_to_jsonl.py
houghtest.py
test_connection.py

# Folder evaluasi (lengkap dengan isinya)
ablation/
references/
eval_plots/
evaluation_plot/

# Output evaluasi di root fastapi-gpt
eval_results.csv
eval_results.jsonl
eval_results.xlsx
eval2.jsonl
eval2_results.csv
eval2_results.jsonl
eval2.xlsx
eval plot*.xlsx
*.xlsx

# Output evaluasi di data/ (hanya output, BUKAN prompts/testsets/knowledge_graphs)
data/augmented_questions.xlsx
data/evaluation_results*
data/few_shot_*
data/final.xlsx
data/inquiry_samples*
data/knowledge_mode_summary.json
data/model_*summary*.json
data/prompt_strategy_comparison.json

# Per-model evaluation output folders di data/
data/google_*/
data/gpt-*/
data/openai_*/
data/qwen*/
data/qwen_*/

# =============================================================================
# Markdown dokumentasi — TIDAK di-track
# Pengecualian eksplisit: prompt template yang dimuat runtime oleh
# router_inquiry.py (PROMPTS_DIR / f"{prompt_type}.md"). README/STRUCTURE
# di data/prompts/ tetap di-ignore karena hanya dokumentasi.
# =============================================================================
*.md
!data/prompts/zero_shot.md
!data/prompts/few_shot.md
!data/prompts/cot.md
!data/prompts/draft_critique_revise.md

# =============================================================================
# Dump database / dataset besar
# =============================================================================
*.sql
*.sqlite
*.sqlite3
*.db

# =============================================================================
# Dokumen non-kode (PDF/DOCX brainstorming, guide, laporan)
# =============================================================================
Brainstorming*.pdf
*guide*.pdf
*guide*.docx
*.docx.pdf
llama_server_guide*
*Report*.pdf
daftar_akun_siswa.pdf

# =============================================================================
# Log server (di root fastapi-gpt)
# =============================================================================
server.log
server_err.log
server_out.log
*.log

# =============================================================================
# File temp / buffer sementara
# =============================================================================
tmp_*.json

# =============================================================================
# Script seeding / export siswa (data sensitif, bukan bagian router)
# =============================================================================
seed_students.py
seed_students_sa3.py
export_students_pdf.py

# =============================================================================
# docs/eval_live — seluruh folder evaluasi live ablation
# =============================================================================
docs/eval_live/
